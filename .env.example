# Public URL of the site (canonical, sitemap, OG). Use the final custom domain when connected.
SITE_URL=https://pollistream.pages.dev

# Optional: Cloudflare Web Analytics beacon token (cookieless). Dashboard > Web Analytics.
PUBLIC_CF_BEACON_TOKEN=

# Optional: Plausible domain, if you prefer Plausible for download events.
PUBLIC_PLAUSIBLE_DOMAIN=

# Optional: public contact email used for sponsorship / support.
PUBLIC_CONTACT_EMAIL=

# Optional: alternate installer source folder (relative to the project root).
INSTALLERS_DIR=installers

