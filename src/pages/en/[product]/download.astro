---
import type { GetStaticPaths } from 'astro'
import DownloadPage from '../../../components/DownloadPage.astro'
import { getProduct, productSlugs, type ProductMeta } from '../../../data/products'

export const getStaticPaths: GetStaticPaths = () => {
  return productSlugs.map((slug) => ({
    params: { product: slug },
    props: { product: getProduct(slug) },
  }))
}

const { product } = Astro.props as { product: ProductMeta }
---

<DownloadPage locale="en" product={product} />
