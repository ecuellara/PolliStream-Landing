---
import type { GetStaticPaths } from 'astro'
import LegalPage from '../../../components/LegalPage.astro'
import type { LegalDocSlug } from '../../../lib/i18n'

export const getStaticPaths: GetStaticPaths = () => [
  { params: { doc: 'privacy' }, props: { doc: 'privacy' } },
  { params: { doc: 'terms' }, props: { doc: 'terms' } },
  { params: { doc: 'cookies' }, props: { doc: 'cookies' } },
]

const { doc } = Astro.props as { doc: LegalDocSlug }
---

<LegalPage locale="en" doc={doc} />
