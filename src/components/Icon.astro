---
interface Props {
  name: string
  size?: number
  class?: string
  strokeWidth?: number
  filled?: boolean
}

const { name, size = 20, class: className = '', strokeWidth = 1.8, filled = false } = Astro.props
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow-right' && <><path d="M4 12h15" /><path d="m13 6 6 6-6 6" /></>}
  {name === 'arrow-left' && <><path d="M20 12H5" /><path d="m11 6-6 6 6 6" /></>}
  {name === 'arrow-up-right' && <><path d="M7 17 17 7" /><path d="M8 7h9v9" /></>}
  {name === 'chevron-down' && <path d="m6 9 6 6 6-6" />}
  {name === 'download' && <><path d="M12 3v12" /><path d="m7 10 5 5 5-5" /><path d="M4 21h16" /></>}
  {name === 'check' && <path d="m4 12 5 5L20 6" />}
  {name === 'external' && <><path d="M14 3h7v7" /><path d="M10 14 21 3" /><path d="M21 14v7H3V3h7" /></>}
  {name === 'menu' && <><path d="M4 7h16" /><path d="M4 12h16" /><path d="M4 17h16" /></>}
  {name === 'close' && <><path d="m6 6 12 12" /><path d="M18 6 6 18" /></>}
  {name === 'play' && <path d="M8 5v14l11-7z" />}
  {name === 'tv' && <><rect x="2" y="5" width="20" height="13" rx="2" /><path d="M8 21h8" /></>}
  {name === 'lg' && <><rect x="2" y="5" width="20" height="13" rx="3" /><path d="M8 21h8" /><circle cx="12" cy="11.5" r="2.5" /></>}
  {name === 'samsung' && <><rect x="2" y="4" width="20" height="14" rx="3" /><path d="M8 21h8" /><path d="M6.5 11.5c2.5-2.6 8.5-2.6 11 0" /></>}
  {name === 'android' && <><rect x="7" y="2" width="10" height="20" rx="2.5" /><path d="M10 5h4" /><path d="M11 19h2" /></>}
  {name === 'android-tv' && <><rect x="2" y="4" width="20" height="14" rx="3" /><path d="M8 21h8" /><circle cx="12" cy="11" r="2.4" /><path d="M12 8.6v-1.4M12 14.8v-1.4M9.6 11H8.2M15.8 11h-1.4" /></>}
  {name === 'windows' && <><path d="M3 3h8v8H3z" /><path d="M13 3h8v8h-8z" /><path d="M3 13h8v8H3z" /><path d="M13 13h8v8h-8z" /></>}
  {name === 'roku' && <><path d="M5 5h14v14H5z" /><path d="m10 9 5 3-5 3z" fill="currentColor" stroke="none" /></>}
  {name === 'apple' && <><rect x="2" y="4" width="13" height="10" rx="1.5" /><path d="M6 18h5M8.5 14v4" /><rect x="17" y="7" width="5" height="12" rx="1.5" /></>}
  {name === 'shield' && <><path d="M12 3 5 6v5c0 4.6 3 8 7 10 4-2 7-5.4 7-10V6z" /><path d="m9 12 2 2 4-4" /></>}
  {name === 'lock' && <><rect x="5" y="10" width="14" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></>}
  {name === 'users' && <><circle cx="9" cy="8" r="3" /><path d="M3 21v-1a6 6 0 0 1 12 0v1" /><path d="M16 5a3 3 0 0 1 0 6" /><path d="M18 15a5 5 0 0 1 3 4v2" /></>}
  {name === 'waveform' && <><path d="M4 10v4" /><path d="M8 6v12" /><path d="M12 3v18" /><path d="M16 7v10" /><path d="M20 10v4" /></>}
  {name === 'spark' && <><path d="m12 3 1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z" /><path d="M19 16v4" /><path d="M17 18h4" /></>}
  {name === 'globe' && <><circle cx="12" cy="12" r="9" /><path d="M3 12h18" /><path d="M12 3a15 15 0 0 1 0 18" /><path d="M12 3a15 15 0 0 0 0 18" /></>}
  {name === 'share' && <><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><path d="m8.6 10.5 6.8-4" /><path d="m8.6 13.5 6.8 4" /></>}
  {name === 'coffee' && <><path d="M4 8h13v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5z" /><path d="M17 9h1.5a2.5 2.5 0 0 1 0 5H17" /><path d="M7 3v2M11 3v2M15 3v2" /></>}
  {name === 'file' && <><path d="M6 2h8l4 4v16H6z" /><path d="M14 2v5h5" /></>}
  {name === 'clock' && <><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></>}
  {name === 'monitor' && <><rect x="2" y="3" width="20" height="14" rx="2" /><path d="M8 21h8" /><path d="M12 17v4" /></>}
  {name === 'grid' && <><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></>}
  {name === 'server' && <><rect x="3" y="4" width="18" height="6" rx="2" /><rect x="3" y="14" width="18" height="6" rx="2" /><path d="M7 7h.01M7 17h.01" /></>}
  {name === 'zap' && <path d="M13 2 4 14h7l-1 8 9-12h-7z" />}
  {name === 'heart' && <path d="M20.8 5.6a5 5 0 0 0-7.1 0L12 7.3l-1.7-1.7a5 5 0 0 0-7.1 7.1L12 21l8.8-8.3a5 5 0 0 0 0-7.1z" />}
  {name === 'info' && <><circle cx="12" cy="12" r="9" /><path d="M12 11v5" /><path d="M12 8h.01" /></>}
  {name === 'search' && <><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></>}
  {name === 'plus' && <><path d="M12 5v14" /><path d="M5 12h14" /></>}
  {name === 'minus' && <path d="M5 12h14" />}
</svg>
