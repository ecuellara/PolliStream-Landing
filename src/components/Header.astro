---
import Logo from './Logo.astro'
import LanguageSwitcher from './LanguageSwitcher.astro'
import Icon from './Icon.astro'
import type { Locale } from '../data/content/types'
import { getContent, homePath } from '../lib/i18n'

interface Props {
  locale: Locale
  alternates: Record<Locale, string>
  downloadHref: string
}

const { locale, alternates, downloadHref } = Astro.props
const t = getContent(locale)
const home = homePath(locale)
const navItems = [
  { label: t.nav.platforms, href: `${home}#platforms` },
  { label: t.nav.features, href: `${home}#features` },
  { label: t.nav.install, href: `${home}#install` },
  { label: t.nav.faq, href: `${home}#faq` },
  { label: t.nav.support, href: `${home}#support` },
]
---

<header class="site-header" data-site-header>
  <div class="container-page site-header__inner">
    <Logo href={home} />

    <nav class="nav-desktop">
      {navItems.map((item) => <a class="nav-link" href={item.href}>{item.label}</a>)}
    </nav>

    <div class="header-actions">
      <LanguageSwitcher current={locale} alternates={alternates} />
      <a class="btn btn-primary btn-sm" href={downloadHref}>
        <Icon name="download" size={14} />
        {t.common.downloadFree}
      </a>
      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={t.common.menu}
        data-menu-toggle
      >
        <Icon name="menu" size={18} />
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" data-mobile-nav>
    <nav>
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="mobile-nav__footer">
      <LanguageSwitcher current={locale} alternates={alternates} variant="mobile" />
      <a class="btn btn-primary btn-sm" href={downloadHref}>
        <Icon name="download" size={14} />
        {t.common.download}
      </a>
    </div>
  </div>
</header>
