---
import Icon from './Icon.astro'
import DeviceDemo from './DeviceDemo.astro'
import type { Locale } from '../data/content/types'
import { getContent } from '../lib/i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getContent(locale)
---

<section class="hero container-page" id="top">
  <div class="hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1 class="hero-title">
        {t.hero.titleA}
        <span class="accent">{t.hero.titleB}</span>
      </h1>
      <p class="hero-lead">{t.hero.description}</p>

      <div class="hero-actions">
        <a class="btn btn-primary" href="#platforms">
          <Icon name="download" size={15} />
          {t.hero.primary}
        </a>
        <a class="btn btn-secondary" href="#features">
          {t.hero.secondary}
          <Icon name="arrow-right" size={15} class="arrow" />
        </a>
      </div>

      <p class="hero-micro">{t.hero.microcopy}</p>

      <div class="hero-stats">
        {t.hero.stats.map((stat) => (
          <div class="hero-stat">
            <div class="hero-stat__value">{stat.value}</div>
            <div class="hero-stat__label">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>

    <DeviceDemo locale={locale} initial="lg" />
  </div>
</section>
