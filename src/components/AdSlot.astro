---
import Icon from './Icon.astro'
import type { Locale } from '../data/content/types'
import type { AdSlotName } from '../data/ads'
import { ads, adSlotId, adSlotHeight } from '../data/ads'
import { getContent } from '../lib/i18n'
import { site } from '../data/site'

interface Props {
  locale: Locale
  slot: AdSlotName
  format?: 'auto' | 'rect'
  class?: string
}

const { locale, slot, format = 'auto', class: className = '' } = Astro.props
const t = getContent(locale)
const adsenseSlot = adSlotId(slot)
const height = adSlotHeight(slot)
const configured =
  (ads.provider === 'adsense' && ads.adsense.client !== '' && adsenseSlot !== '') ||
  (ads.provider === 'adsterra' && ads.adsterra.key !== '') ||
  (ads.provider === 'custom' && ads.custom.html.trim() !== '')
const sponsorHref = site.contactEmail ? `mailto:${site.contactEmail}?subject=PolliStream%20sponsor` : ''
// With a network selected, an unconfigured slot stays invisible instead of
// showing an empty dashed box. Placeholders are only for the "no network" case.
const showPlaceholder = ads.showPlaceholders && ads.provider === 'none'
---

{ads.enabled && (configured || showPlaceholder) && (
  <aside
    class={`ad-slot ${className}`}
    data-format={format}
    data-ad-slot={slot}
    data-ad-provider={ads.provider}
    data-ad-configured={configured ? 'true' : 'false'}
    data-ad-consent-required={ads.requireConsent ? 'true' : 'false'}
    data-ad-auto-ads={ads.autoAds ? 'true' : 'false'}
    data-ad-height={height}
    data-adsense-client={ads.adsense.client}
    data-adsense-slot={adsenseSlot}
    data-adsterra-key={ads.adsterra.key}
    data-adsterra-width={ads.adsterra.width}
    data-adsterra-height={ads.adsterra.height}
    data-adsterra-script={ads.adsterra.scriptSrc}
    style={`--ad-height: ${height}px`}
    aria-label={t.common.adLabel}
  >
    <span class="ad-slot__label">{t.common.adLabel}</span>

    <div class="ad-slot__placeholder" data-ad-placeholder>
      {configured ? (
        <>
          <strong>{t.common.adsOff}</strong>
          <span>{t.common.adsOffBody}</span>
          <button class="ad-slot__consent" type="button" data-consent-open>
            <Icon name="check" size={12} />
            {t.common.activateAds}
          </button>
        </>
      ) : (
        <>
          <strong>{t.common.sponsor}</strong>
          {sponsorHref ? (
            <a href={sponsorHref}>{t.common.sponsorCta} →</a>
          ) : (
            <span>{t.common.sponsorCta}</span>
          )}
        </>
      )}
    </div>

    <div class="ad-slot__mount" data-ad-mount hidden></div>

    {ads.provider === 'custom' && ads.custom.html.trim() !== '' && (
      <template data-ad-custom>
        <Fragment set:html={ads.custom.html} />
      </template>
    )}
  </aside>
)}

<style>
  .ad-slot__consent {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 4px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-lime);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .ad-slot__placeholder a {
    color: var(--color-lime);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
