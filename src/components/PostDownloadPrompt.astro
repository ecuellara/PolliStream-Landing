---
import Icon from './Icon.astro'
import ShareOptions from './ShareOptions.astro'
import type { Locale } from '../data/content/types'
import { getContent, homePath } from '../lib/i18n'
import { site } from '../data/site'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getContent(locale)
const shareUrl = `${site.url}${homePath(locale)}`
---

<dialog
  class="post-download"
  data-post-download-dialog
  data-share-modal="post-download"
  data-share-url={shareUrl}
  data-share-title="PolliStream"
  aria-labelledby="post-download-title"
>
  <div class="post-download__panel">
    <button
      class="post-download__close"
      type="button"
      data-post-download-close
      aria-label={t.common.close}
    >
      <Icon name="close" size={18} />
    </button>

    <p class="eyebrow">{t.support.shareTitle}</p>
    <h2 class="post-download__title" id="post-download-title">{t.download.afterDownloadTitle}</h2>
    <p class="post-download__body">{t.download.afterDownloadBody}</p>

    <ShareOptions locale={locale} />

    <div class="post-download__actions">
      <a class="btn btn-secondary" href={`${homePath(locale)}#support`} data-post-download-donate>
        {t.support.donate}
        <Icon name="arrow-up-right" size={14} />
      </a>
    </div>

    <button class="post-download__dismiss" type="button" data-post-download-close>
      {t.common.close}
    </button>
  </div>
</dialog>

<style>
  .post-download {
    width: min(460px, calc(100% - 2rem));
    max-width: 460px;
    margin: auto;
    padding: 0;
    border: 1px solid rgba(198, 255, 61, 0.4);
    border-radius: var(--radius-xl);
    background: var(--color-panel);
    color: var(--color-paper);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.45);
  }

  .post-download::backdrop {
    background: rgba(3, 7, 5, 0.78);
    backdrop-filter: blur(5px);
  }

  .post-download__panel {
    position: relative;
    padding: clamp(1.5rem, 5vw, 2.25rem);
    background:
      radial-gradient(90% 90% at 0% 0%, rgba(198, 255, 61, 0.12), transparent 70%),
      var(--color-panel);
  }

  .post-download__close {
    position: absolute;
    top: 14px;
    right: 14px;
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border: 1px solid var(--color-white-10);
    border-radius: 50%;
    color: var(--color-muted);
  }

  .post-download__close:hover {
    color: var(--color-paper);
  }

  .post-download__title {
    max-width: 15ch;
    margin-top: 16px;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 5vw, 2rem);
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .post-download__body {
    margin-top: 12px;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .post-download__actions {
    display: grid;
    gap: 10px;
    margin-top: 22px;
  }

  .post-download__dismiss {
    display: block;
    margin: 16px auto 0;
    color: var(--color-muted);
    font-size: 0.8rem;
  }

  .post-download__dismiss:hover {
    color: var(--color-paper);
  }
</style>
