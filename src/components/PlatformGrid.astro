---
import Icon from './Icon.astro'
import type { Locale } from '../data/content/types'
import { getContent, downloadPath, platformLabel, productPath } from '../lib/i18n'
import { products } from '../data/products'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getContent(locale)
---

<section class="section container-page" id="platforms">
  <header class="section-head" data-reveal>
    <p class="eyebrow">{t.platforms.kicker}</p>
    <div class="section-head__row">
      <h2 class="section-title">{t.platforms.title}</h2>
      <p class="section-lead">{t.platforms.body}</p>
    </div>
  </header>

  <a class="platform-highlight" href="#installer" data-reveal>
    <span class="platform-highlight__badge">{t.installer.badge}</span>
    <Icon name="android" size={15} />
    <span class="platform-highlight__text">{t.installer.highlight}</span>
    <Icon name="arrow-right" size={14} class="platform-highlight__arrow" />
  </a>

  <div class="platform-grid">
    {products.map((product, index) => (
      <article class="platform-card" data-accent={product.accent} data-reveal>
        <div class="platform-card__top">
          <span class="platform-card__icon">
            <Icon name={product.icon} size={24} />
          </span>
          <span class="platform-card__index">{String(index + 1).padStart(2, '0')} / {String(products.length).padStart(2, '0')}</span>
        </div>

        <span class="platform-card__status" data-status={product.status}>
          {product.status === 'live' ? t.platforms.live : t.platforms.soon}
        </span>

        <p class="platform-card__platform">{platformLabel(locale, product.slug)}</p>
        <h3 class="platform-card__name">{product.name}</h3>

        <div class="platform-card__meta">
          <span>{t.common.version} <strong>{product.version}</strong></span>
          <span>{t.common.size} <strong>{product.size}</strong></span>
          <span>{t.common.format} <strong>{product.fileType}</strong></span>
        </div>

        {product.status === 'live' && (
          <p class="platform-card__downloads" data-download-count={product.slug} hidden>
            <Icon name="download" size={12} />
            <strong data-download-count-value>0</strong>
            <span>{t.common.downloads}</span>
          </p>
        )}

        <div class="platform-card__footer">
          {product.status === 'live' ? (
            <a
              class="platform-card__cta"
              href={downloadPath(locale, product.slug)}
              data-track="download_intent"
              data-track-platform={product.slug}
              data-track-label={product.slug}
            >
              {t.platforms.cta}
              <Icon name="arrow-right" size={14} />
            </a>
          ) : (
            <a class="platform-card__cta" href={productPath(locale, product.slug)}>
              {t.common.readMore}
              <Icon name="arrow-right" size={14} />
            </a>
          )}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .platform-highlight {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
    padding: 12px 16px;
    border: 1px dashed rgba(198, 255, 61, 0.45);
    border-radius: 999px;
    background: rgba(198, 255, 61, 0.06);
    color: var(--color-paper);
    font-size: 0.84rem;
    transition:
      border-color 160ms ease,
      background 160ms ease;
  }

  .platform-highlight:hover {
    border-color: var(--color-lime);
    background: rgba(198, 255, 61, 0.12);
  }

  .platform-highlight svg {
    flex: none;
    color: var(--color-lime);
  }

  .platform-highlight__badge {
    flex: none;
    padding: 3px 8px;
    border-radius: 999px;
    background: var(--color-lime);
    color: #0a1206;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .platform-highlight__text {
    flex: 1 1 220px;
    min-width: 0;
  }

  .platform-highlight__arrow {
    margin-left: auto;
    transition: transform 160ms ease;
  }

  .platform-highlight:hover .platform-highlight__arrow {
    transform: translateX(3px);
  }

  @media (max-width: 620px) {
    .platform-highlight {
      border-radius: var(--radius-lg);
      font-size: 0.8rem;
    }

    .platform-highlight__arrow {
      display: none;
    }
  }
</style>

