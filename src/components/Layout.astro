---
import '../styles/global.css'
import Header from './Header.astro'
import Footer from './Footer.astro'
import ConsentBanner from './ConsentBanner.astro'
import type { Locale } from '../data/content/types'
import { htmlLang, ogLocale, locales, getContent } from '../lib/i18n'
import { site } from '../data/site'
import interFont from '../assets/fonts/inter-latin.woff2?url'
import bricolageFont from '../assets/fonts/bricolage-latin.woff2?url'
import monoFont from '../assets/fonts/jetbrains-mono-latin.woff2?url'

interface Props {
  locale: Locale
  title: string
  description: string
  alternates: Record<Locale, string>
  canonicalPath: string
  noindex?: boolean
  image?: string
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  downloadHref?: string
}

const {
  locale,
  title,
  description,
  alternates,
  canonicalPath,
  noindex = false,
  image,
  jsonLd,
  downloadHref = '#platforms',
} = Astro.props

const canonical = `${site.url}${canonicalPath}`
const t = getContent(locale)
const imagePath = image ?? site.ogImages[locale]
const ogImage = imagePath.startsWith('http') ? imagePath : `${site.url}${imagePath}`
const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {locales.map((alt) => (
      <link rel="alternate" hreflang={htmlLang[alt]} href={`${site.url}${alternates[alt]}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${site.url}${alternates.es}`} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    {!noindex && <meta name="robots" content="index,follow,max-image-preview:large" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale[locale]} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={bricolageFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin="anonymous" />

    <meta name="theme-color" content={site.themeColor} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="64x64" href="/brand/icon-64.png" />
    <link rel="apple-touch-icon" href="/brand/icon-256.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <link rel="preconnect" href="https://pagead2.googlesyndication.com" />
    <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />

    <script is:inline>
      document.documentElement.classList.add('js')
      setTimeout(function () {
        if (!document.documentElement.classList.contains('reveal-ready')) {
          document.documentElement.classList.add('js-fallback')
        }
      }, 4000)
    </script>

    {site.cfBeaconToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token":"${site.cfBeaconToken}"}`}
      ></script>
    )}

    {site.plausibleDomain && (
      <script
        is:inline
        defer
        data-domain={site.plausibleDomain}
        src="https://plausible.io/js/script.js"
      ></script>
    )}

    {jsonLdItems.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
  </head>

  <body data-site-url={site.url} data-plausible-domain={site.plausibleDomain}>
    <a class="skip-link" href="#main">{t.common.skip}</a>
    <Header locale={locale} alternates={alternates} downloadHref={downloadHref} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <ConsentBanner locale={locale} />

    <script>
      import '../scripts/ui.client'
    </script>
  </body>
</html>
